{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.muhlegger/agent-eyes",
  "description": "Lets a coding agent see the web UI it just changed: findings as text, motion included.",
  "repository": {
    "url": "https://github.com/muhlegger/agent-eyes",
    "source": "github"
  },
  "version": "0.3.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@muhlegger/agent-eyes",
      "version": "0.3.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
