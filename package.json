{
  "name": "@muhlegger/agent-eyes",
  "version": "0.3.0",
  "description": "Lets an AI coding agent see the web UI it just changed: screenshots logged in at every width, findings as text (motion glitches, layout shift, overflow), before/after diffs. One shell command, an MCP server, or a Claude Code plugin.",
  "type": "module",
  "bin": {
    "agent-eyes": "bin/agent-eyes.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "playwright": "1.61.1"
  },
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/muhlegger/agent-eyes.git"
  },
  "keywords": [
    "screenshot",
    "playwright",
    "ai-agents",
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "mcp-server",
    "cursor",
    "visual-testing",
    "animation",
    "layout-shift",
    "ui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/muhlegger/agent-eyes#readme",
  "bugs": "https://github.com/muhlegger/agent-eyes/issues"
}
